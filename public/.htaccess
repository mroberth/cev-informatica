<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si la petición es un archivo o carpeta real que existe (como CSS, JS o imágenes), no hagas nada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # De lo contrario, envía TODO limpiamente a index.php
    RewriteRule ^ index.php [L]
</IfModule>